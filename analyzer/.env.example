# lemo analyzer configuration — copy to analyzer/.env

# Where analysed songs (stems + reference melody) are cached
LEMO_DATA_DIR=./data
LEMO_HOST=127.0.0.1
LEMO_PORT=8787

# YouTube import via yt-dlp. Personal, local use only; off by default.
# Downloading may be against YouTube's Terms of Service — your call.
LEMO_ENABLE_YOUTUBE=false

# Optional synced-lyrics lookup on LRCLIB (only when you click "find on lrclib")
LEMO_ENABLE_LRCLIB=true

# Melody model: crepe-full (best), crepe-tiny (faster), pyin (no neural net)
LEMO_MELODY_MODEL=crepe-full
# auto | cpu | mps | cuda
LEMO_DEVICE=auto

LEMO_MAX_UPLOAD_MB=80
LEMO_MAX_DURATION_MIN=15

# Song storage limit: everything lemo stores for songs (audio, analyses, key/speed renders).
# At this size new songs are refused with a message on the site; songs already stored keep
# working. Songs are kept until then. Optional: drop the least recently used songs earlier
# (LEMO_USER_CACHE_MB) or songs unused for N days (LEMO_USER_KEEP_DAYS, 0 = never).
LEMO_SONG_LIMIT_GB=10
LEMO_USER_KEEP_DAYS=0
LEMO_VARIANT_CACHE_MB=300

# Sign-in: only Google accounts signed in through this Firebase project may use the
# analyzer (the web app sends their ID token). Firebase console → Project settings → Project ID.
LEMO_FIREBASE_PROJECT_ID=

# Your account's data (settings, song list, per-song edits & scores) in local PostgreSQL
DATABASE_URL=postgresql://lemo:password@localhost:5432/lemo
